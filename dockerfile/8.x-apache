ARG USE_PHP_VERSION

FROM php:${USE_PHP_VERSION}-apache

LABEL NAME="toroxx12/php"
LABEL Version="${USE_PHP_VERSION}"
LABEL MAINTAINER="lawrencelau"


# for ttf-mscorefonts-installer
RUN echo "deb http://deb.debian.org/debian bookworm contrib non-free" > /etc/apt/sources.list.d/contrib.list

RUN apt-get update && apt-get upgrade -y && apt-get update && apt-get install -y build-essential libssl-dev libfreetype6-dev \
    zlib1g-dev libcurl4-gnutls-dev libpng-dev libjpeg62-turbo-dev vim \
    libmcrypt-dev libicu-dev libxml2-dev libwebp-dev libldap-dev libzip-dev libonig-dev libsodium-dev \
    autoconf gcc make graphviz aspell ghostscript g++ libtool \
    libnss3-dev libgpgmepp-dev qtbase5-dev libcairo2-dev libboost-dev poppler-utils

RUN apt-get install -y python3 python3-venv python3-dev python3-pip curl
    # && pip3 install unoserver --break-system-packages

RUN docker-php-ext-install soap \
    # && docker-php-ext-install opcache \
    && docker-php-ext-install curl \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd \
    && docker-php-ext-install intl \
    && docker-php-ext-install ldap \
    && docker-php-ext-install mysqli \
    && docker-php-ext-install pdo \
    && docker-php-ext-install pdo_mysql \
    && docker-php-ext-install mbstring \
    && docker-php-ext-install xml \
    && docker-php-ext-install zip \
    && docker-php-ext-install exif \
    && docker-php-ext-install sodium 

RUN pecl install redis \
	&& pecl install xdebug \
	&& docker-php-ext-enable redis xdebug

RUN apt-get clean

RUN a2enmod rewrite
RUN mv /usr/local/etc/php/php.ini-development /usr/local/etc/php/php.ini
RUN sed -i 's/^error_reporting = .*/error_reporting = E_ALL \& ~E_NOTICE \& ~E_STRICT \& ~E_DEPRECATED/' /usr/local/etc/php/php.ini

RUN a2enmod proxy && a2enmod proxy_http && a2enmod proxy_http2 && a2enmod proxy_wstunnel && a2enmod ssl

# add composer
RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
    && php -r "if (hash_file('sha384', 'composer-setup.php') === 'c8b085408188070d5f52bcfe4ecfbee5f727afa458b2573b8eaaf77b3419b0bf2768dc67c86944da1544f06fa544fd47') { echo 'Installer verified'.PHP_EOL; } else { echo 'Installer corrupt'.PHP_EOL; unlink('composer-setup.php'); exit(1); }" \
    && php composer-setup.php \
    && php -r "unlink('composer-setup.php');"

COPY scripts /scripts
RUN chmod -R a+x /scripts

CMD ["/scripts/init.sh"]

EXPOSE 80
EXPOSE 443
STOPSIGNAL SIGTERM